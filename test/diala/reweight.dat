# Activate MOLINFO functionalities
MOLINFO STRUCTURE=../ref.pdb

# Compute the backbone dihedral angle phi, defined by atoms C-N-CA-C
# you might want to use MOLINFO shortcuts
phi: TORSION ATOMS=@phi-2

# Compute the backbone dihedral angle psi, defined by atoms N-CA-C-N
# here also you might want to use MOLINFO shortcuts
psi: TORSION ATOMS=@psi-2

# Activate well-tempered metadynamics
metad: METAD ...
   ARG=phi,psi

   PACE=10000000 HEIGHT=0.0

   # The bias factor should be wisely chosen
   BIASFACTOR=5

   # Gaussian width (sigma) should be chosen based on CV fluctuation in unbiased run
   SIGMA=0.25,0.25

   # Gaussians will be written to file and also stored on grid
   FILE=../HILLS_all
   GRID_MIN=-pi,-pi GRID_MAX=pi,pi

#   WALKERS_N=@NWAKERS
#   WALKERS_ID=@WALKER_ID
#   WALKERS_DIR=./
#   WALKERS_RSTRIDE=100
    
   RESTART=YES
...

# Print both collective variables on COLVAR file every 1 steps
PRINT ARG=phi,psi,metad.bias FILE=COLVAR_REWEIGHT STRIDE=1

# Use the metadynamics bias as argument
as: REWEIGHT_BIAS ARG=metad.bias
# Calculate histograms
# using the weights obtained from the metadynamics bias potentials (umbrella-sampling-like reweighting)
# Look at the manual to understand the parameters of the HISTOGRAM action!
hphi: HISTOGRAM ARG=phi STRIDE=1 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=100 BANDWIDTH=0.001 LOGWEIGHTS=as
hpsi: HISTOGRAM ARG=psi STRIDE=1 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=100 BANDWIDTH=0.001 LOGWEIGHTS=as

# Convert histograms h(s) to free energies F(s) = -kBT * log(h(s))
ffphi: CONVERT_TO_FES GRID=hphi
ffpsi: CONVERT_TO_FES GRID=hpsi

# Print out the free energies F(s) to file once the entire trajectory is processed
DUMPGRID GRID=ffphi FILE=fes_phi.dat
DUMPGRID GRID=ffpsi FILE=fes_psi.dat


